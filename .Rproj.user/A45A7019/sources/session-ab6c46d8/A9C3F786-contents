https://platform.who.int/mortality/countries/country-details/MDB/philippines

```{r}
phil <- readxl::read_xlsx("./Phillipines/WHO Phillipines.xlsx")

phil$Age <- factor(phil$Age, levels = phil$Age)

totpop <- sum(phil$Pop)

totdths <- sum(phil$Dths)

phil$pop_prop <- (phil$Pop/totpop)

phil$dth_rate <- (phil$Dths/phil$Pop)

print(paste0("Overall mortality =", round(totdths/totpop, digits=4)))

phil %>% kable() %>% kable_styling()

ggplot(data = phil) + geom_bar(aes(x=phil$Age, y=phil$pop_prop*100), stat="identity") + ggtitle("Population distribution by age") + xlab("Age") + ylab("Population (%)")

ggplot(data = phil) + geom_bar(aes(x=phil$Age, y=phil$dth_rate*100000), stat="identity") + ggtitle("Death rate by age") + xlab("Age") + ylab("Death rate/100,000")


#make version of phillipines data with no age 0, add age 0 pop to age 0-4, take death rate to be age 1-4 dth rate 

phil2 <- phil %>% dplyr::select(Age, pop_prop, dth_rate)

phil2 <- phil2[2:dim(phil2)[1],]

age0_prop <- 1-sum(phil2$pop_prop)

phil2$Age <- as.character(phil2$Age)

phil2$Age[phil2$Age=="1-4"] <- "0-4"

phil2$pop_prop[phil2$Age=="0-4"] <- phil2$pop_prop + age0_prop

phil2$Age <- factor(phil2$Age, levels=phil2$Age)

