##### Simulated population version 1

```{r}
#initialize ages at t0

sim.pop <- phil %>% dplyr::select(Age, pop_prop, dth_rate)

sim.pop$pop <- (sim.pop$pop_prop*1000000)

#run for 15 years, age increases by 1 each year unless death, if death the added back to pop at age 1
steps = 15

#initialize data frame to save changes in pop over time

pop.change <- data.frame(matrix(nrow=steps, ncol=3))
colnames(pop.change) <- c("time", "tot_pop", "dths")
  
sim.pop2 <- sim.pop


for(i in 1:steps){
  
pop.change$time[i] <- i

pop.change$tot_pop[i] <- sum(sim.pop2$pop)

#calculate deaths and remove
sim.pop2$dths <-sim.pop2$dth_rate*sim.pop2$pop

#save total deaths (add back in later)
tot.dths <- sum(sim.pop2$dths)

#subtract deaths for each age
sim.pop2$pop_old <- sim.pop2$pop

sim.pop2$pop_minus_dths <- sim.pop2$pop_old - sim.pop2$dths

#move 1/5 of each age bucket forward
sim.pop2$move <- sim.pop2$pop_minus_dths/5 
sim.pop2$move[1] <- 0
sim.pop2$move[dim(sim.pop2)[1]] <- 0
sim.pop2$pop_aged_minus_move <- sim.pop2$pop_minus_dths - sim.pop2$move


sim.pop2$pop_aged_all <- NA
sim.pop2$add <-NA
for(j in 2:(dim(sim.pop2)[1]-1)){
   sim.pop2$pop_aged_all[j+1] <- sim.pop2$pop_aged_minus_move[j+1] + sim.pop2$move[j]
   sim.pop2$add[j+1] <- sim.pop2$move[j]
}

#move age 0 pop to age 1-4 pop
sim.pop2$pop_aged_all[2] <- sim.pop2$pop_aged_minus_move[1] + sim.pop2$pop_aged_minus_move[2]

#add back in deaths to age 0
sim.pop2$pop_aged_all[1] <- tot.dths

#update pop after aging/adding in deaths  
sim.pop2$pop <- sim.pop2$pop_aged_all

#pop.change$dths[i] <- tot.dths
pop.change$dths[i] <- tot.dths

sim.pop2$time  <- i
if(i==1){
res <- sim.pop2

}

if(i>1){
res <- rbind(res, sim.pop2)

}

}

#sim.pop2  %>% kable()%>% kable_styling()

p1 <- ggplot(data = sim.pop) + geom_bar(aes(x=sim.pop$Age, y=sim.pop$pop), stat="identity") + ggtitle("Population distribution by age at t_0") + xlab("Age") + ylab("Population") + ylim(0,125000)

p2 <- ggplot(data = sim.pop2) + geom_bar(aes(x=sim.pop2$Age, y=sim.pop2$pop), stat="identity") + ggtitle("Population distribution by age at t_max") + xlab("Age") + ylab("Population") +ylim(0,125000)


ggarrange(p1, p2, nrow=2)

pop.change %>% kable()%>% kable_styling()

