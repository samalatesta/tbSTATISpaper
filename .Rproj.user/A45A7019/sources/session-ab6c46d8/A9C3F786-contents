sim.pop$cure.trt <- sim.pop$on.trt*.9
sim.pop$trt.dths <- sim.pop$on.trt*sim.pop$mortality

#calculate mortality among TB group minus TB deaths
sim.pop$tb.dths_allcause <- (sim.pop$tb.dis)*sim.pop$mortality - sim.pop$tb.dths
#uninfected: uninfected plus infected/uninfected mortality and death from prevalent disease in previous year        
