sim.pop$dths.inf.2yr <-sim.pop$mortality*sim.pop$inf.2yr
sim.pop$dths.inf.3yr <-sim.pop$mortality*sim.pop$inf.3yr
sim.pop$dths.inf.4yr <-sim.pop$mortality*sim.pop$inf.4yr
sim.pop$dths.inf.5yr <-sim.pop$mortality*sim.pop$inf.5yr
sim.pop$dths.old <-sim.pop$mortality*sim.pop$old.inf

#calculate deaths for newly infected
sim.pop$dths.new.inf <-sim.pop$mortality*sim.pop$new.inf

#all disease group is sum of incident disease and prevalent disease from year before minus the treatment cures, death from disease, and self-cures 
sim.pop$tb.dis <- sim.pop$tb.dis + sim.pop$progress2tb
   
 
#calculate TB deaths, treatment cures, self cures
