sim.pop$progress2tb <- sim.pop$new.inf*dis.prob[1] + sim.pop$inf.1yr*dis.prob[2] + sim.pop$inf.2yr*dis.prob[3] + sim.pop$inf.3yr*dis.prob[4] + sim.pop$inf.4yr*dis.prob[5] + sim.pop$inf.5yr*dis.prob[6] + sim.pop$old.inf*dis.prob[7]

#calculate deaths for infected and uninfected groups 
